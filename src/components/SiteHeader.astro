---
import '../styles/site-header.css';
import { siteLabels, type SiteLocale } from '../lib/site-locale';
interface Props { locale: SiteLocale; active?: 'us' | 'asia' | 'weekly' | 'about'; switchHref: string; home?: boolean; }
const { locale, active, switchHref, home = false } = Astro.props;
const t = siteLabels[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = `${base}/${locale === 'en' ? 'en/' : '?locale=zh-CN'}`;
const pageHref = (page: string) => `${base}/${locale === 'en' ? 'en/' : ''}${page}/${locale === 'zh' ? '?locale=zh-CN' : ''}`;
const links = [
  { key: 'us', label: t.us, href: `${home ? '' : homeHref}#us-session` },
  { key: 'asia', label: t.asia, href: `${home ? '' : homeHref}#asia-session` },
  { key: 'weekly', label: t.weekly, href: pageHref('weekly') },
  { key: 'about', label: t.about, href: pageHref('about') },
];
---
<header class="topbar site-header">
  <a class="brand" href={homeHref}><span class="brand-mark">Q</span><span>QUANT <b>MARKET INTEL</b></span></a>
  <nav class="top-nav" aria-label={t.navigation}>
    {links.map(link => <a href={link.href} data-section={link.key} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <div class="site-utilities">
    <a class="locale-switch" data-locale-switch href={switchHref} lang={locale === 'en' ? 'zh-CN' : 'en'}>{t.language}</a>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label={t.switchDark} aria-pressed="false" data-dark-label={t.switchDark} data-light-label={t.switchLight}><span aria-hidden="true">☀ / ☾</span></button>
  </div>
  <script is:inline>
    const initialThemeButton = document.querySelector('#theme-toggle');
    const initiallyDark = document.documentElement.dataset.theme === 'dark';
    initialThemeButton?.setAttribute('aria-pressed', String(initiallyDark));
    initialThemeButton?.setAttribute('aria-label', initiallyDark ? initialThemeButton.dataset.lightLabel : initialThemeButton.dataset.darkLabel);
  </script>
</header>
<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const themeKey = 'market-intel-theme';
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const applyTheme = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
    themeToggle?.setAttribute('aria-label', (theme === 'dark' ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel) || 'Theme');
  };
  const savedTheme = () => { try { return localStorage.getItem(themeKey); } catch { return null; } };
  const restoreTheme = () => {
    const saved = savedTheme();
    applyTheme(saved === 'dark' || saved === 'light' ? saved : systemTheme.matches ? 'dark' : 'light');
  };
  restoreTheme();
  systemTheme.addEventListener('change', () => { if (!['dark', 'light'].includes(savedTheme() || '')) restoreTheme(); });
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem(themeKey, next); } catch {}
    applyTheme(next);
  });
  const languageLink = document.querySelector<HTMLAnchorElement>('[data-locale-switch]');
  const languageHref = languageLink?.getAttribute('href')?.split('#')[0];
  const syncSection = () => {
    if (languageLink && languageHref) languageLink.setAttribute('href', languageHref + location.hash);
    if (document.querySelector('.site-header a[data-section="us"]')?.getAttribute('href')?.startsWith('#')) {
      for (const link of document.querySelectorAll<HTMLAnchorElement>('.site-header [data-section]')) {
        if (link.hash === (location.hash || '#us-session')) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    }
  };
  syncSection();
  window.addEventListener('hashchange', syncSection);
</script>
