---
import { buildAsiaReportDocument } from '../lib/asia-report-document.ts';
import { ASIA_DOCUMENT_LOCALE } from '../lib/asia-document-locale.ts';
import { toEnglishPresentation } from '../lib/english-content.ts';
import { renderMarkdown } from '../lib/markdown.ts';
import type { ChartCard } from '../lib/chart-data.ts';
import ReportDocumentView from './ReportDocumentView.astro';
interface Props { report: {id:string;date:string;kind:string;summary?:unknown}; markdown:string; locale?:'en'|'zh'; charts?:ChartCard[]; }
const {report,markdown,locale='en',charts=[]}=Astro.props;
const document=buildAsiaReportDocument(report,charts,markdown,locale);
const bodyHtml=renderMarkdown(locale==='en'?toEnglishPresentation(markdown):markdown);
---
<article class="report-native" data-native-asia data-report-id={report.id}>
 <ReportDocumentView document={document} />
 <details class="report-original"><summary>{ASIA_DOCUMENT_LOCALE[locale].original}</summary><div class="markdown-body" set:html={bodyHtml} /></details>
</article>
