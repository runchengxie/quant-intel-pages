---
import {buildWeeklyTrend, type TrendField} from '../lib/weekly-trend.ts';
import {weeklyLabels, type WeeklyLocale} from '../lib/weekly-locale.ts';
interface Props {title:string;rows:Record<string,any>[];fields:TrendField[];locale:WeeklyLocale;unit:string;includeZero?:boolean;domain?:[number,number]}
const {title,rows,fields,locale,unit,includeZero=false,domain}=Astro.props;
const chart=buildWeeklyTrend(rows,fields,includeZero,domain);
const t=weeklyLabels[locale];
const number=(value:number)=>new Intl.NumberFormat(locale==='en'?'en-US':'zh-CN',{maximumFractionDigits:2,notation:Math.abs(value)>100000 || (value!==0&&Math.abs(value)<0.001)?'scientific':'standard'}).format(value);
---
<figure class="native-trend" data-weekly-static-chart data-unit={unit}>
  <figcaption><h3>{title}</h3><span>{unit} · {chart.count} {t.observations}</span></figcaption>
  <div class="trend-plot">
    <div class="trend-ticks" aria-hidden="true">{chart.ticks.map(tick=><span style={`top:${tick.position}%`}>{number(tick.value)}</span>)}</div>
    <svg viewBox="0 0 760 240" preserveAspectRatio="none" role="img" aria-label={`${title} · ${chart.firstDate} – ${chart.lastDate}`}>
      <title>{title} · {chart.firstDate} – {chart.lastDate}</title>
      {chart.ticks.map(tick=><line x1="4" x2="756" y1={tick.position/100*240} y2={tick.position/100*240} class="trend-grid" vector-effect="non-scaling-stroke" />)}
      {chart.series.map(series=><g><polyline points={series.points} fill="none" stroke={series.color} stroke-width="2" vector-effect="non-scaling-stroke" />{chart.count===1 && <circle cx="380" cy={series.points.split(',')[1]} r="3.5" fill={series.color} vector-effect="non-scaling-stroke" />}</g>)}
    </svg>
  </div>
  <div class="trend-dates"><time>{chart.firstDate}</time><time>{chart.lastDate}</time></div>
  <ul class="trend-legend">{chart.series.map(series=><li><span class="trend-swatch" style={`background:${series.color}`}></span><span>{series.label}</span><strong>{number(series.last)}</strong></li>)}</ul>
</figure>
<style>
.native-trend{margin:0;padding:1.1rem;border:1px solid var(--desk-line,#ded8cd);border-radius:12px;min-width:0;background:var(--desk-surface,#fbf9f5)}
figcaption{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.4rem;margin-bottom:1rem}h3{font-size:1rem;margin:0}figcaption>span{font-size:.78rem;color:var(--desk-muted,#696863)}
.trend-plot{display:grid;grid-template-columns:48px minmax(0,1fr);height:240px;gap:8px}.trend-ticks{position:relative;font-size:.72rem;font-variant-numeric:tabular-nums}.trend-ticks span{position:absolute;right:0;transform:translateY(-50%);white-space:nowrap}svg{display:block;width:100%;height:240px;overflow:visible}.trend-grid{stroke:var(--desk-line,#ddd8d1);stroke-dasharray:3 5;stroke-width:1}
.trend-dates{display:flex;justify-content:space-between;margin:.5rem 0 0 56px;font-size:.7rem;color:var(--desk-muted,#696863);font-variant-numeric:tabular-nums}.trend-legend{list-style:none;padding:0;display:grid;gap:.4rem;margin:.9rem 0 0}.trend-legend li{display:flex;align-items:baseline;gap:.45rem;font-size:.8rem;min-width:0}.trend-legend strong{margin-left:auto;white-space:nowrap;font-variant-numeric:tabular-nums}.trend-swatch{width:16px;height:3px;flex-shrink:0;align-self:center}
</style>
