---
import "../styles/site.css";
import "../styles/editorial.css";
import "../styles/weekly-native.css";
import '../styles/report-editorial.css';
import SiteHeader from "./SiteHeader.astro";
import ThemeInit from "./ThemeInit.astro";
import ReportDocumentView from "./ReportDocumentView.astro";
import {buildWeeklyReportDocument} from "../lib/weekly-report-document";
import {buildReportSvg} from "../lib/report-document-svg";
import {reportDocumentLabels} from "../lib/report-document-labels";
import {
  weeklyLabels,
  weeklyStateLabel,
  type WeeklyLocale,
} from "../lib/weekly-locale.ts";
import { loadWeeklyRecaps, type WeeklyRecap } from "../lib/weekly-recap.ts";
import { renderMarkdown } from "../lib/markdown.ts";
interface Props {
  locale: WeeklyLocale;
  report?: WeeklyRecap;
  landing?: boolean;
}
const { locale, report: datedReport, landing = false } = Astro.props;
const reports = loadWeeklyRecaps();
const report = landing ? reports[0] : datedReport;
const history = reports.filter(row => row.date !== report?.date);
const t = weeklyLabels[locale];
const reportDocument = report ? buildWeeklyReportDocument(report,locale) : undefined;
const styledSvg = reportDocument ? buildReportSvg(reportDocument) : undefined;
const number = (value: number, digits = 2) =>
  new Intl.NumberFormat(locale === "en" ? "en-US" : "zh-CN", {
    maximumFractionDigits: digits,
  }).format(value);
const weeks = (value: number) =>
  new Intl.NumberFormat(locale === "en" ? "en-US" : "zh-CN", {
    style: "unit", unit: "week", unitDisplay: "long",
  }).format(value);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const route = (language: WeeklyLocale, date = "") =>
  `${base}/${language === "en" ? "en/" : ""}weekly/${date ? `${date}/` : ""}${language === "zh" ? "?locale=zh-CN" : ""}`;
---

<!doctype html>
<html lang={locale === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{report?`${report.date} · `:''}{t.title}</title>
    {locale === "zh" && <script
      is:inline
      define:vars={{ englishRoute: route("en", landing ? undefined : report?.date) }}
    >
      if (new URLSearchParams(location.search).get("locale") !== "zh-CN")
        location.replace(englishRoute + location.hash);
    </script>}
    <ThemeInit />
  </head>
  <body class="editorial-site weekly-page">
    <SiteHeader locale={locale} active="weekly" switchHref={route(locale === "en" ? "zh" : "en", landing ? undefined : report?.date)} />
    <main class="shell">
      <div class="content">
        <section class="panel">
          {report ? (
            <article
              data-weekly-report
              data-weekly-native
              data-report-date={report.date}
              data-report-content-hash={report.content_hash}
            >
              <div class="report-edition"><span>{landing ? t.latest : t.edition}</span><time datetime={report.date}>{report.date}</time></div>
              <h1>{t.title}</h1>
              <p class="report-lede" data-weekly-regime>{t.valueState} · {weeklyStateLabel(report.summary.value_regime, locale)} · {weeks(report.summary.value_streak_weeks)}</p>
              <dl class="weekly-summary" data-weekly-summary>
                <div><dt>{t.returns}</dt><dd>{number(report.summary.value_return_12w_percent)}%</dd></div>
                <div><dt>{t.sizeSignal}</dt><dd>{weeklyStateLabel(report.summary.size_signal, locale)}</dd></div>
                <div><dt>{t.smallCrowding}</dt><dd>{number(report.summary.small_crowding, 4)}</dd></div>
                <div><dt>{t.largeCrowding}</dt><dd>{number(report.summary.large_crowding, 4)}</dd></div>
              </dl>
              <p class="link-row"><a data-weekly-permalink href={route(locale, report.date)}>{t.permalink}</a></p>
              <p>
                {t.generated}:{" "}
                <time datetime={report.generated_at}>
                  {new Intl.DateTimeFormat(
                    locale === "en" ? "en-US" : "zh-CN",
                    {
                      dateStyle: "medium",
                      timeStyle: "long",
                      timeZone: "Asia/Shanghai",
                    },
                  ).format(new Date(report.generated_at))}{" "}
                  · Asia/Shanghai
                </time>
              </p>

              <div class="link-row">
                <a
                  href={`${base}/${report.image.source_url}?v=${report.image.sha256}`}
                  download={`${report.report_id}.png`}
                >
                  {reportDocumentLabels[locale].originalImage}
                </a>
                <a href={`${base}/${report.source_url}`}>{t.source}</a>
              </div>

              <section class="weekly-report-body" data-weekly-report-body>
                <ReportDocumentView document={{...reportDocument!,panels:reportDocument!.panels.filter(p=>p.id!=='weekly-state')}} />
              </section>
              <p class="link-row"><button type="button" data-report-image data-report-date={report.date} data-report-kind="weekly" data-report-content-hash={report.content_hash} data-chart-target="#weekly-report-chart svg" data-status-target="#weekly-image-status">{t.download}</button></p>
              <p id="weekly-image-status" class="report-caption" role="status"></p>
              <details class="report-export secondary-report" data-report-export><summary>{reportDocumentLabels[locale].imageView}</summary><div id="weekly-report-chart" class="market-chart-graphic market-report-graphic" set:html={styledSvg} /></details>
              <details class="secondary-report" data-weekly-original>
                <summary>{t.original}</summary>
                <p><a href={`${base}/${report.source_url}`}>{t.source}</a></p>
                <div class="markdown-body" lang="zh-CN" set:html={renderMarkdown(report.markdown)} />
              </details>
              <details class="secondary-report" data-weekly-interactive>
                <summary>{t.interactive}</summary>
                <div
                  data-weekly-charts
                  data-labels={JSON.stringify(t)}
                  data-series={JSON.stringify(report.series)}
                >
                  <h3>{t.value}</h3>
                  <div
                    data-weekly-value
                    role="img"
                    aria-label={t.value}
                    style="height:360px"
                  ></div>
                  <h3>{t.size}</h3>
                  <div
                    data-weekly-size
                    role="img"
                    aria-label={t.size}
                    style="height:360px"
                  ></div>
                  <p role="status" data-chart-status></p>
                </div>
              </details>
              <details class="secondary-report">
                <summary>{t.table}</summary>
                {(["value", "size"] as const).map((kind) => (
                  <div class="weekly-table">
                    <h3>{kind === "value" ? t.value : t.size}</h3>
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">{t.date}</th>
                          {(kind === "value"
                            ? [t.returns, t.wealth]
                            : [t.strength, t.small, t.large]
                          ).map((label) => (
                            <th scope="col">{label}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {report.series[kind].map(
                          (row: Record<string, string | number>) => (
                            <tr>
                              <th scope="row">{row.date}</th>
                              {(kind === "value"
                                ? ["return_12w_percent", "wealth_index"]
                                : [
                                    "relative_strength",
                                    "small_crowding",
                                    "large_crowding",
                                  ]
                              ).map((key) => (
                                <td>
                                  {new Intl.NumberFormat(
                                    locale === "en" ? "en-US" : "zh-CN",
                                    { maximumFractionDigits: 6 },
                                  ).format(Number(row[key]))}
                                </td>
                              ))}
                            </tr>
                          ),
                        )}
                      </tbody>
                    </table>
                  </div>
                ))}
              </details>
              <details class="secondary-report">
                <summary>{t.sources}</summary>
                <pre>{JSON.stringify(report.sources,null,2)}</pre>
                <p>SHA256: {report.content_hash}</p>
              </details>
              <p class="report-caption">{t.limitations}</p>
            </article>
          ) : (
            <><h1>{t.title}</h1><p>{t.empty}</p></>
          )}
        </section>
        {report && (
          <section class="panel" data-weekly-history>
            <h2>{t.history}</h2>
            {history.length === 0 && <p class="section-note">{t.noHistory}</p>}
            <ul>
              {history.map((row) => (
                <li>
                  <a href={route(locale, row.date)}>{row.date}</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
    {report && <script>
      import { initializeWeeklyCharts } from "../lib/weekly-charts.ts";
      initializeWeeklyCharts();
      import {initializeReportDownloads} from '../lib/report-controls';
      initializeReportDownloads(document.documentElement.lang.startsWith('en')?'en-US':'zh-CN');
    </script>}

  </body>
</html>
