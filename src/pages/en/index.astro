---
import { buildUsEditorialSvg, buildAsiaEditorialSvg as buildAsiaReportSvg } from '../../lib/report-exports';
import UsNativeReport from '../../components/UsNativeReport.astro';
import AsiaNativeReport from '../../components/AsiaNativeReport.astro';
import { reportEditorialLabels } from '../../lib/report-editorial-locale';
import SiteHeader from '../../components/SiteHeader.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import '../../styles/site.css';
import UsDailyStatus from '../../components/UsDailyStatus.astro';
import AsiaNews from '../../components/AsiaNews.astro';
import '../../styles/editorial.css';
import '../../styles/research-language.css';
import '../../styles/report-editorial.css';
import { loadReports, loadSummaries, loadMarketDaily, loadMarketDailyHistory, loadLatestInsight, loadChart, loadMarkdown, VISUAL_REPORT_START_DATE } from '../../lib/reports.ts';
import { formatEvidenceLine } from '../../lib/evidence.ts';
import { buildEveningNotes } from '../../lib/evening-notes.ts';
import marketDailyUtils from '../../lib/market-daily-utils.ts';
import { US_REPORT_LABELS, ASIA_RESEARCH_LABELS } from '../../lib/locale.ts';
import { toEnglishPresentation, asiaResearchPresentation } from '../../lib/english-content.ts';
import type { Evidence } from '../../lib/insights.ts';
import { publicReportIdentity } from '../../lib/report-image-identity.ts';

const labels = Object.fromEntries(Object.entries(US_REPORT_LABELS).map(([key, pair]) => [key, pair[1]]));

const reports = loadReports();
const summaries = loadSummaries(reports).sort((a, b) => b.date.localeCompare(a.date));
const eveningNotes = buildEveningNotes(reports);
const eveningNoteDates = new Set(eveningNotes.map((row) => row.date));
const displayNotes = [...eveningNotes, ...summaries.filter((row) => !eveningNoteDates.has(row.date))].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const latestEvening = reports.filter((row) => row.kind === 'evening').sort((a, b) => b.date.localeCompare(a.date))[0];
const latestEveningDate = latestEvening?.date;
const eveningHistory = reports.filter((row) => row.kind === 'evening' && row.date >= VISUAL_REPORT_START_DATE && row.id !== latestEvening?.id);
const latestEveningMarkdown = latestEvening ? loadMarkdown(latestEvening) : null;
const latestEveningContentHash = latestEvening ? publicReportIdentity(latestEvening) : null;
const asiaReportSvg = latestEvening && latestEveningMarkdown ? buildAsiaReportSvg(latestEvening, loadChart(latestEvening.id), latestEveningMarkdown, toEnglishPresentation, 'en-US') : null;
const market = loadMarketDaily();
const marketChartSummary = market?.publication === 'public' ? marketDailyUtils.summarizeMarketDaily(market) : null;
const marketChartSvg = marketChartSummary ? buildUsEditorialSvg(marketChartSummary, toEnglishPresentation, 'en-US') : null;
const marketRevisionNotes = marketChartSummary ? marketDailyUtils.formatMarketDailyRevision(marketChartSummary, 'en-US') : [];
const marketDataNotes = marketChartSummary ? marketDailyUtils.formatMarketDailyDataNotes(marketChartSummary, 'en-US') : [];
const marketHistory = loadMarketDailyHistory()
  .filter((row) => row.date >= VISUAL_REPORT_START_DATE && row.date !== market?.date)
  .map((row) => {
    const summary = marketDailyUtils.summarizeMarketDaily(row);
    return { ...row, nativeSummary: summary, chartSvg: summary ? buildUsEditorialSvg(summary, toEnglishPresentation, 'en-US') : null };
  });
const marketGeneratedTime = market?.generated_at || market?.as_of;
const marketGeneratedLabel = marketGeneratedTime && !Number.isNaN(Date.parse(String(marketGeneratedTime)))
  ? new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(String(marketGeneratedTime))) : null;
const sourceRows = marketChartSummary?.rows || [];
const sourceLinks = [...new Map([
  ...sourceRows.map((row) => [row.sourceUrl, { href: row.sourceUrl, label: toEnglishPresentation(row.sourceLabel), context: toEnglishPresentation(row.label) }] as const),
  ...(marketChartSummary?.claims || []).flatMap((claim) => claim.sourceUrls.map((href) => [href, { href, label: new URL(href).hostname, context: labels.researchContext }] as const)),
].filter(([href]) => /^https:\/\//.test(href))).values()];
const insight = loadLatestInsight();
const insightOverview = insight?.analysis?.overview?.text ? asiaResearchPresentation(String(insight.analysis.overview.text)) : null;
const evidenceById = new Map((insight?.evidence || []).map((row) => [row.id, row]));
const citedEvidence = (ids: string[] | undefined) => (ids || []).map((id) => evidenceById.get(id)).filter((item): item is Evidence => item !== undefined);
const timestampLabel = (value: string | undefined) => { const date = new Date(value ?? ''); return Number.isNaN(date.getTime()) ? 'time unavailable' : new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Shanghai', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(date); };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content="Quant Market Intel: daily U.S. and Asian market reports with source dates and evidence links." /><title>Quant Market Intel</title>

  <ThemeInit />
  </head>
  <body class="editorial-site">
    <SiteHeader locale="en" home switchHref={`${base}/?locale=zh-CN`} />
    <main class="shell"><div class="content">
      <section class="hero" id="reports"><div class="hero-copy"><span class="eyebrow">Public daily market intelligence</span><h1>Quant Market Intel</h1><p>Structured U.S. and Asian market reports with source dates, evidence links, and explicit data-quality boundaries.</p></div><nav class="session-nav" aria-label="Latest publications"><a href="#us-session"><span>Latest U.S. daily report</span><strong>{market?.date || 'Pending'}</strong><small>07:00 · Beijing time</small></a><a href="#asia-session"><span>Latest Asia evening report</span><strong>{latestEveningDate || 'Pending'}</strong><small>19:00 · Beijing time</small></a></nav></section>
      <section class="panel" id="us-session" aria-labelledby="market-title"><div class="section-heading"><span class="eyebrow">Latest U.S. daily report · {market?.date || 'Pending'}</span><h2 id="market-title">{reportEditorialLabels.en.usTitle}</h2></div>
        {market?.markdown ? <>
          <UsDailyStatus report={market} locale="en-US" />
          {marketChartSummary && <UsNativeReport summary={marketChartSummary} locale="en" />}
          <p class="section-note">The report date is {market.date}. {marketGeneratedLabel && <>{labels.generated}: {marketGeneratedLabel} (America/New_York). </>}The image and facts below use only verified market data and preserve source dates.</p>
          {marketRevisionNotes.map(note => <p class="section-note">{note}</p>)}
          {marketDataNotes.length > 0 && <details class="secondary-report market-data-notes"><summary>{labels.dataNotes}</summary>{marketDataNotes.map(note => <p>{note}</p>)}</details>}
          <div class="link-row report-actions"><a href={`${base}/reports/${market.date}-market-daily.md`}>Source Markdown</a>{market.hasCitationFreeMarkdown && <a href={`${base}/reports/${market.date}-market-daily-no-citations.md`}>Reading copy</a>}<a href={`${base}/reports/${market.date}-market-daily.txt`}>Plain text</a>{marketChartSvg && <button type="button" id="download-market-chart" data-report-image data-report-date={market.date} data-report-kind="market-daily" data-report-content-hash={market.content_hash} data-chart-target="#market-daily-chart svg" data-status-target="#market-chart-download-status">{labels.downloadPng}</button>}</div>
          <p id="market-chart-download-status" class="section-note" role="status" aria-live="polite"></p>
          {marketChartSvg ? <div class="market-brief"><details class="report-export secondary-report" data-report-export><summary>{reportEditorialLabels.en.imageView}</summary><div class="market-chart-graphic market-report-graphic" id="market-daily-chart" set:html={marketChartSvg} /></details><details class="secondary-report market-sources"><summary>Check source links ({sourceLinks.length})</summary><ul>{sourceLinks.map((source) => <li>{source.context} · <a href={source.href} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ul></details></div> : <p class="empty">No verified U.S. chart is currently available.</p>}
          {marketHistory.length > 0 && <div class="market-history"><h3>{labels.recentReports}</h3>{marketHistory.map((row) => <details class="secondary-report"><summary>{row.date}</summary><UsDailyStatus report={row} locale="en-US" />{row.nativeSummary && <UsNativeReport summary={row.nativeSummary} locale="en" />}<div class="link-row report-actions"><a href={`${base}/reports/${row.date}-market-daily.md`}>Source Markdown</a>{row.chartSvg && <button type="button" data-report-image data-report-date={row.date} data-report-kind="market-daily" data-report-content-hash={row.content_hash} data-chart-target={`#market-history-chart-${row.date} svg`} data-status-target={`#market-history-status-${row.date}`}>{labels.downloadPng}</button>}</div><p id={`market-history-status-${row.date}`} class="section-note" role="status" aria-live="polite"></p>{row.chartSvg && <details class="report-export secondary-report" data-report-export><summary>{reportEditorialLabels.en.imageView}</summary><div class="market-chart-graphic market-report-graphic" id={`market-history-chart-${row.date}`} set:html={row.chartSvg} /></details>}</details>)}</div>}
        </> : <p class="empty">No public U.S. daily report is currently available.</p>}
      </section>
      <section id="asia-session" class="session-group" aria-labelledby="asia-session-title"><section class="panel"><div class="section-heading"><span class="eyebrow">Latest Asia evening report · {latestEveningDate || 'Pending'}</span><h2 id="asia-session-title">{reportEditorialLabels.en.asiaTitle}</h2></div>{latestEvening ? <>{latestEveningMarkdown && <AsiaNativeReport report={latestEvening} markdown={latestEveningMarkdown} charts={loadChart(latestEvening.id)} locale="en" />}<p class="section-note">The report date is {latestEvening.date}. The source-language report remains available for full evidence review.</p><div class="link-row report-actions"><a href={`${base}/en/reports/${latestEvening.id}/`}>Read full report</a><a href={`${base}/${latestEvening.source_url}`}>Source Markdown</a>{asiaReportSvg && <button type="button" id="download-asia-report" data-report-image data-report-date={latestEvening.date} data-report-kind="asia-daily" data-report-content-hash={latestEveningContentHash} data-chart-target="#asia-daily-chart svg" data-status-target="#asia-chart-download-status">{labels.downloadPng}</button>}</div><p id="asia-chart-download-status" class="section-note" role="status" aria-live="polite"></p>{asiaReportSvg ? <details class="report-export secondary-report" data-report-export><summary>{reportEditorialLabels.en.imageView}</summary><div class="market-chart-graphic market-report-graphic" id="asia-daily-chart" set:html={asiaReportSvg} /></details> : <p>{toEnglishPresentation(String(latestEvening.summary || ''))}</p>}</> : <p class="empty">No public Asia evening report is currently available.</p>}</section>
      <AsiaNews reportId={latestEvening?.id} locale="en-US" />
      <section class="panel" aria-labelledby="insight-title"><div class="section-heading"><h2 id="insight-title">Market interpretation and validation</h2></div>{insight?.analysis?.overview?.text ? <><p class="section-note">{insight.date} · data through {timestampLabel(insight.as_of)} · generated {timestampLabel(insight.generated_at)} Beijing time.</p><p>{insightOverview || ASIA_RESEARCH_LABELS.translationMissing[1]}</p><a class="source-link" href={`${base}/?locale=zh-CN#insight-title`}>{ASIA_RESEARCH_LABELS.original[1]}</a><details><summary>View supporting evidence</summary><ul>{citedEvidence(insight.analysis.overview.evidence_ids).map((item) => <li><a href={`${base}/en/reports/${item.report_id}/`}>{toEnglishPresentation(String(item.section))}</a>: {toEnglishPresentation(formatEvidenceLine(item.section, item.text))}</li>)}</ul></details></> : <p class="empty">No validated market interpretation is currently available.</p>}</section></section>
      <section class="panel" aria-labelledby="summary-title"><div class="section-heading"><h2 id="summary-title">Recent evening notes</h2></div>{displayNotes.length ? <div class="notes-list">{displayNotes.map((row) => <article><time>{row.date}</time>{row.source === 'evening' && <a href={`${base}/en/reports/${row.reportId}/`}>Evening facts · evidence</a>}<p>{toEnglishPresentation(String(row.text || ''))}</p></article>)}</div> : <p class="empty">No notes are currently available.</p>}</section>
      {eveningHistory.length > 0 && <section class="reports-section" aria-labelledby="reports-title"><div class="section-heading"><h2 id="reports-title">Historical Asia close reviews</h2></div><div class="report-list">{eveningHistory.map((report) => <article class="report-tile"><div class="report-meta"><time>{report.date}</time><span>Asia evening report</span></div><h3><a href={`${base}/en/reports/${report.id}/`}>{toEnglishPresentation(String(report.title || ''))}</a></h3><p>{toEnglishPresentation(String(report.summary || ''))}</p><div class="link-row"><a href={`${base}/en/reports/${report.id}/`}>Read visual review</a></div></article>)}</div></section>}
    </div></main>
    <footer class="footer"><span>QUANT MARKET INTEL</span><span>For research reference only</span></footer>

    <script>
      import { initializeReportDownloads } from '../../lib/report-controls.ts';
      initializeReportDownloads('en-US');
    </script>
  </body>
</html>
