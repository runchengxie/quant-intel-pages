---
import AsiaNativeReport from '../../../components/AsiaNativeReport.astro';
import { reportEditorialLabels } from '../../../lib/report-editorial-locale';
import SiteHeader from '../../../components/SiteHeader.astro';
import ThemeInit from '../../../components/ThemeInit.astro';
import '../../../styles/site.css';
import AsiaNews from '../../../components/AsiaNews.astro';
import '../../../styles/editorial.css';
import '../../../styles/research-language.css';
import '../../../styles/report-editorial.css';
import ChartCards from '../../../components/ChartCards.astro';
import { loadReports, loadMarkdown, loadChart } from '../../../lib/reports.ts';
import { renderMarkdown } from '../../../lib/markdown.ts';
import { buildAsiaReportSvg } from '../../../lib/asia-report-image';
import { localePath } from '../../../lib/locale.ts';
import { toEnglishPresentation } from '../../../lib/english-content.ts';

export function getStaticPaths() {
  return loadReports().map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdown = loadMarkdown(report);
const body = renderMarkdown(toEnglishPresentation(markdown));
const charts = report.kind === 'evening' ? loadChart(report.id) : null;
const visualReport = charts ? toEnglishPresentation(buildAsiaReportSvg(report, charts, markdown, toEnglishPresentation, 'en-US') ?? '') : null;
const chartSources = [...new Map((charts || []).flatMap((chart) => (chart.points || [])
  .filter((point) => /^https?:\/\//.test(point.source_url))
  .map((point) => [point.source_url, toEnglishPresentation(point.source_label)]))).entries()];
---
<!doctype html>
<html lang="en-US">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f4f0e8" /><title>{toEnglishPresentation(String(report.title ?? ''))} · Quant Market Intel</title><ThemeInit />
  </head>
  <body class="editorial-site">
    <SiteHeader locale="en" active={report.kind === 'morning' ? 'us' : 'asia'} switchHref={`${base}/reports/${report.id}/`} />
    <main class="report-shell">
      <nav class="crumb"><a href={localePath('en-US', base)}>← Back to English reports</a></nav>
      <div class="report-heading"><p class="section-note"><time datetime={report.date}>{report.date}</time></p><span class="eyebrow">{report.kind === 'morning' ? 'Morning report' : 'Asia evening report'}</span><h1>{toEnglishPresentation(String(report.title ?? ''))}</h1><p>{toEnglishPresentation(String(report.summary || ''))}</p>{report.generation_mode === 'backfill' && <p class="backfill-note">This report was backfilled; the generation time is recorded in the source report.</p>}<p class="section-note">This English route translates the public presentation text while preserving the original facts, dates, evidence links, and source identifiers.</p><a class="source-link" href={`${base}/${report.source_url}`}>View canonical Markdown</a></div>
      {visualReport ? <section class="panel" aria-label="Asia market visual review">
        <AsiaNativeReport report={report} markdown={markdown} locale="en" />
        <div class="link-row report-actions"><button type="button" id="download-asia-report" data-report-image data-report-date={report.date} data-report-kind="asia-daily" data-chart-target="#asia-daily-chart svg" data-status-target="#asia-chart-download-status">Download PNG</button></div>
        <p id="asia-chart-download-status" class="section-note" role="status" aria-live="polite"></p>
        <details class="report-export secondary-report" data-report-export><summary>{reportEditorialLabels.en.imageView}</summary><div class="market-chart-graphic market-report-graphic" id="asia-daily-chart" set:html={visualReport} /></details>
        <details class="secondary-report"><summary>Read source report and evidence</summary><article class="report-body markdown-body" set:html={body} /><ChartCards reportId={report.id} locale="en" interactive={false} />{chartSources.length > 0 && <><h3>Chart sources</h3><ul>{chartSources.map(([href, label]) => <li><a href={href} target="_blank" rel="noreferrer">{label} · {href}</a></li>)}</ul></>}</details>
      </section> : report.kind === 'evening' ? <AsiaNativeReport report={report} markdown={markdown} locale="en" /> : <><ChartCards reportId={report.id} locale="en" /><article class="panel report-body markdown-body" set:html={body} /></>}
      {report.kind === 'evening' && <AsiaNews reportId={report.id} locale="en-US" />}
    </main>
    <footer class="footer"><span>QUANT MARKET INTEL</span><span>For research reference only</span></footer>
    <script>
      import { initializeReportDownloads } from '../../../lib/report-controls.ts';
      initializeReportDownloads('en-US');
    </script>
  </body>
</html>
