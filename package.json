{
  "name": "quant-intel-pages",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build",
    "prebuild": "npm run verify:reports",
    "verify:reports": "tsx tools/check-reports.ts",
    "check": "npm run legacy:check && npm run theme:check && astro check",
    "test": "tsx --test tests/*.cjs",
    "test:browser": "playwright test",
    "legacy:build": "tsx tools/generate-legacy.ts",
    "legacy:check": "tsx tools/generate-legacy.ts --check",
    "theme:build": "node --import tsx tools/generate-report-theme.ts",
    "theme:check": "node --import tsx tools/generate-report-theme.ts --check"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "astro": "7.3.5",
    "echarts": "6.1.0",
    "marked": "17.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
